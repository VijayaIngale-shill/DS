df["AGE_ZSCORE"] = standard.fit_transform(df[["age"]])

print("\nScaled Data:")
print(df[["age", "AGE_MINMAX", "AGE_ZSCORE"]].head())
print("\nStatistics:")
print(df[["age", "Medu", "Fedu"]].describe())

df_clean = df.dropna()

